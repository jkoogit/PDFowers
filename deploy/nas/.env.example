PDFOWERS_DEV_PORT=4173
DATABASE_URL=postgresql://<ubuntu-db-user>:<ubuntu-db-password>@<ubuntu-db-host>:<ubuntu-db-port>/<ubuntu-db-name>
KAKAO_REST_API_KEY=<kakao-rest-api-key>
APP_BASE_URL=https://<dev-domain>
KAKAO_REDIRECT_PATH=/auth/kakao/callback
KAKAO_CLIENT_SECRET=<kakao-client-secret>
KAKAO_SCOPE=
NPM_CONFIG_OPTIONAL=true
SMTP_HOST=<smtp-host>
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=<smtp-user>
SMTP_PASS=<smtp-password>
SMTP_FROM=noreply@pdfrend.com
